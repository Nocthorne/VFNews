# Copie este arquivo para ".env" e preencha com suas próprias chaves.
# NUNCA faça commit do arquivo ".env" — apenas deste exemplo.

# Configurações de API
GOOGLE_API_KEY=sua_chave_aqui
NEWS_API_KEY=sua_chave_aqui
GNEWS_API_KEY=sua_chave_aqui

# Configurações do Banco de Dados (PostgreSQL)
# Se não configurada, a aplicação roda em modo fallback usando os CSVs.
DATABASE_URL=postgresql://usuario:senha@localhost:5432/vfnews

# Configurações do Flask
PORT=5050
FLASK_DEBUG=False
